# RudraShield AI Environment Configuration
# Project: Digital Risk Protection — Social & App Monitoring

# Application
PROJECT_NAME="RudraShield AI"
VERSION="1.0.0"

# Security
# Replace this example with a unique random secret of at least 32 characters.
SECRET_KEY="REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local default; Docker uses /app/data/rudrashield.db with the mounted backend/data directory.
DATABASE_URL="sqlite:///./rudrashield.db"

# Storage
UPLOAD_DIR="uploads"
BRAND_IMAGE_STORAGE_BACKEND="disabled"
# For explicitly managed persistent storage only; do not assume container-local disk is durable.
BRAND_IMAGE_STORAGE_DIR=""
BRAND_IMAGE_REVIEW_THRESHOLD=75

# Demo fixtures are never added automatically at application startup.
DEMO_MODE=false
